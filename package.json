{
  "name": "code-config-hub",
  "version": "0.4.8",
  "description": "Desktop visual editor for Codex CLI and Claude Code configuration files.",
  "repository": {
    "type": "git",
    "url": "https://github.com/final00000000/CodeConfigHub.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "package:win": "electron-builder --win nsis",
    "package:mac": "electron-builder --mac dmg zip"
  },
  "keywords": [
    "electron",
    "codex",
    "claude",
    "config-editor"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.3",
    "smol-toml": "^1.4.2"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.desktop.codeconfighub",
    "productName": "CodeConfigHub",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*",
      "build/**/*"
    ],
    "directories": {
      "buildResources": "build"
    }
  }
}
